<%@ page pageEncoding="UTF-8" %>
    <p><label for="nome">Nome *</label><br>
      <input id="nome" name="nome" maxlength="200" autocomplete="name" value="<%= Html.escape(pessoa.getNome()) %>" required></p>
    <p><label for="documento">Documento *</label><br>
      <input id="documento" name="documento" maxlength="30" value="<%= Html.escape(pessoa.getDocumento()) %>" required></p>
    <p><label for="dt_nascimento">Data de nascimento</label><br>
      <input type="date" id="dt_nascimento" name="dt_nascimento" min="1000-01-01" max="9999-12-31" value="<%= Html.escape(pessoa.getDt_nascimento()) %>"></p>
    <% Endereco enderecoPessoa = pessoa.getEndereco(); %>
    <% if (enderecoPessoa != null) { %>
      <p>Endereço: <%= Html.escape(enderecoPessoa.getLogradouro()) %>, <%= Html.escape(enderecoPessoa.getNumero()) %>.
        <a href="<%= ctx %>/enderecos?acao=editar&amp;id=<%= enderecoPessoa.getId() %>">Editar endereço</a></p>
    <% } else { %>
      <fieldset>
        <legend>Endereço<%= edicao ? " (opcional)" : "" %></legend>
        <p><label for="logradouro">Logradouro</label><br>
          <input id="logradouro" name="logradouro" maxlength="255" autocomplete="address-line1" <%= edicao ? "" : "required" %>></p>
        <p><label for="bairro">Bairro</label><br><input id="bairro" name="bairro" maxlength="150"></p>
        <p><label for="numero">Número</label><br><input id="numero" name="numero" maxlength="30"></p>
        <p><label for="ibge">IBGE</label><br>
          <input id="ibge" name="ibge" inputmode="numeric" pattern="[0-9]{7}" maxlength="7" <%= edicao ? "" : "required" %>></p>
        <p><label for="cep">CEP</label><br>
          <input id="cep" name="cep" inputmode="numeric" pattern="[0-9]{8}" maxlength="8" autocomplete="postal-code" <%= edicao ? "" : "required" %>></p>
      </fieldset>
    <% } %>
